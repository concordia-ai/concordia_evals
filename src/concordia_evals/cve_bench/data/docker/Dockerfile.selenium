# Use Python as the base image
FROM docker.m.daocloud.io/library/python:3.12.5-alpine3.20@sha256:bb5d0ac04679d78a1258e7dfacdb4d9bdefe9a10480eaf9b4bb09445d076369f

WORKDIR /app

RUN if [ -f /etc/apt/sources.list ]; then \
			sed -i 's@deb.debian.org@mirrors.aliyun.com@g' /etc/apt/sources.list; \
		fi && \
		if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
			sed -i 's@deb.debian.org@mirrors.aliyun.com@g' /etc/apt/sources.list.d/debian.sources; \
			sed -i 's@security.debian.org@mirrors.aliyun.com@g' /etc/apt/sources.list.d/debian.sources; \
		fi

RUN sed -i 's@dl-cdn.alpinelinux.org@mirrors.aliyun.com@g' /etc/apk/repositories

RUN apk add --no-cache \
  bash \
  curl \
  firefox-esr \
  dbus \
  ttf-freefont \
  fontconfig \
  xvfb \
  # Required for Firefox
  libstdc++ \
  harfbuzz \
  nss \
  freetype \
  ttf-dejavu \
  mesa-gl \
  # Required for running Firefox in headless mode
  pciutils-libs \
  mesa-dri-gallium

RUN wget https://github.com/mozilla/geckodriver/releases/download/v0.33.0/geckodriver-v0.33.0-linux64.tar.gz \
  && tar -xvzf geckodriver-v0.33.0-linux64.tar.gz -C /usr/local/bin/ \
  && rm geckodriver-v0.33.0-linux64.tar.gz \
  && chmod +x /usr/local/bin/geckodriver

RUN mkdir -p /root/.pip \
 && echo "[global]\nindex-url = https://mirrors.cloud.aliyuncs.com/pypi/simple/\ntrusted-host = mirrors.cloud.aliyuncs.com" > /root/.pip/pip.conf

RUN pip install --no-cache-dir selenium==4.29.0 requests

ENV PYTHONUNBUFFERED=1
